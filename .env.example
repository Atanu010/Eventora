# Client
VITE_API_URL=http://localhost:3000

# Server
PORT=3000
NODE_ENV=development

# Local PostgreSQL development
POSTGRES_DB=eventora_dev
POSTGRES_USER=eventora_dev
POSTGRES_PASSWORD=eventora_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eventora_dev:eventora_dev_password@localhost:5432/eventora_dev

# Authentication
JWT_SECRET=replace-with-a-local-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h

# Razorpay test-mode credentials (server only)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-a-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-test-webhook-secret

# Optional development-only seed credentials
SEED_DEVELOPMENT_PASSWORD=eventora-development-only-password
